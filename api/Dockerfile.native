# syntax=docker/dockerfile:1

# Production image: GraalVM native binary on a minimal glibc base (ADR-13).
# linux/amd64 only (ADR-10) — native images are per-arch.
FROM ghcr.io/graalvm/native-image-community:21 AS build
RUN microdnf install -y findutils || (dnf install -y findutils || yum install -y findutils)
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew --no-daemon :app:nativeCompile

FROM debian:12-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfreetype6 fontconfig \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA
# Flyway cannot scan classpath directories in a native image ("unsupported
# protocol: resource"), so the module-owned migrations are baked onto the
# filesystem and Flyway reads them from there (JVM/dev still uses classpath:).
COPY --from=build /workspace/users/src/main/resources/db/migration/users /app/migrations/users
COPY --from=build /workspace/catalog/src/main/resources/db/migration/catalog /app/migrations/catalog
ENV MIGRATIONS_LOCATION_PREFIX=filesystem:/app/migrations
# Copy the whole native output, not just the binary: GraalVM emits the JDK's AWT
# shared libraries (libawt.so, libawt_headless.so, libjavajpeg.so, liblcms.so,
# libfontmanager.so) next to the binary, and ImageIO (ADR-12 resize) loads them
# relative to the executable at runtime.
COPY --from=build /workspace/app/build/native/nativeCompile/ /app/
EXPOSE 8080
ENTRYPOINT ["/app/rewear-api"]
